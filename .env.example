# Copy to .env.local. These values are read only by the Next.js server.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
# Optional workspace-specific hostname. Do not infer the ID from your API key.
SFM_WORKSPACE_ID=
# DASHSCOPE_WORKSPACE_ID is accepted as a legacy alias.
ASR_MODEL=qwen-audio-3.1-asr-flash
TEXT_MODEL=qwen3.8-flash
API_TIMEOUT_MS=30000
# Optional explicit HTTPS endpoints in the SAME region as your key:
# DASHSCOPE_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_API_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Without a workspace ID, the documented legacy regional DashScope host is used.
# Force the explicit preset-only demonstration (even with a key present):
# AY_SAMPLE_MODE=true
